# Copy to .env and fill in. Never commit .env or paste keys into chat.

# Whose assistant it is. OWNER_NAME is required, with no default: the service and the channel refuse to start
# without it. It is how the assistant names you in the meeting ("Sam's AI assistant", "Sam's notes"), so use the
# name people know you by. Each of these three is one line of letters, spaces, apostrophes, hyphens and dots
# (the company also digits, "&", commas and brackets, as in "Acme 3D", "Smith & Co" or "Acme (UK)"), at most 60 characters.
# See docs/make-it-yours.md.
OWNER_NAME=
# Your full name, for the assistant's prompts and the minutes ("You are Alex, Sam Rivera's AI assistant").
# OWNER_NAME unless set.
# OWNER_FULL_NAME=
# Your company, if any. Used in the assistant's rules ("Sam works at Acme." when the profile has no About), as a
# word for speech recognition, and on the bot page. Every sentence that uses it is left out when it is unset.
# It is never in the consent line, the chat notice or the minutes.
# COMPANY_NAME=
# Longer prose about you and your work: standing context, which questions go to your session, where the
# meeting-assistant agent looks, and what it must never share or open. profile.md in this folder unless set
# (gitignored; copy profile.example.md to start one). A leading "~" is your home folder. A file named here that
# isn't there stops the service and the channel at start-up, since it holds your Never share and Never open.
# PROFILE_FILE=profile.md

# The assistant's name: what it answers to and introduces itself by. One word of letters, 3 to 20 long, not an
# everyday word, and not the name of anyone you meet with (yours included). Alex comes with the spellings and
# mishearings speech recognition was seen to write for it. Try another with: npm run check-name -- <name>
# See docs/choosing-a-name.md.
AGENT_NAME=Alex
# Other spellings speech recognition writes for the name that are not everyday words, comma-separated.
# They count anywhere in a line, but never for "please leave". Find them in a meeting's transcript in
# data/transcripts/. Never the name of anyone you meet with, nor a form of address ("dude", "boss").
# AGENT_NAME_VARIANTS=
# Mishearings that are ordinary words, comma-separated. They count only as the first word of a line
# (or after "hey", "hi", "ok", "okay" or "so"), for leaving too: never the name of anyone you meet with, or
# "Mark, you can go now." said to a colleague called Mark makes the assistant leave and delete the record;
# nor a form of address or a reply ("dude", "sweet"), which is said to anyone.
# AGENT_NAME_MISHEARD=
# The name in the meeting's participant list. "<AGENT_NAME> (<OWNER_NAME>'s AI assistant)" unless set. It must
# say the assistant is an AI: the word "AI" has to be in it, and not denied ("not AI", "not a bot or AI",
# "AI-free"), or the service and the channel refuse to start. Start it with the name on its own and put the rest
# in brackets ("Nova (AI)", not "Nova AI"): people say "<what they read first>, please leave".
# AGENT_BOT_NAME=

# Speech to text, answers and voice. npm run check tests each of these.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# The public port: your tunnel points here (http://127.0.0.1:8787). It serves only what the meeting bot
# needs, and listens on this computer only (127.0.0.1). Set HOST=0.0.0.0 only if the tunnel runs on another
# machine; the service then warns at every start.
PORT=8787
# HOST=127.0.0.1
# The control side (npm run join, the Claude Code channel, the detailed /health) has no port: it is a Unix
# socket in the data folder, data/control.sock, which only you can open. Set CONTROL_SOCKET only if the
# service says that path is too long for a socket (103 bytes at most on macOS), to a shorter path in a
# folder only you can open (mkdir -m 700 ~/.agent-voice).
# CONTROL_SOCKET=~/.agent-voice/control.sock

# Limits on cost. The most meetings the bot is in at once: a join beyond it is refused.
# MAX_MEETINGS=3
# The longest the bot stays in one meeting, in minutes (at most 1440), counted from when its page first
# connects. It then posts a line in the chat saying it has reached its time limit, and leaves the call;
# the meeting gets its minutes as usual.
# MAX_MEETING_MINUTES=180

# Shared secret in the bot page URL, so only your bot can use this service.
# Generate one with: openssl rand -hex 24
AGENT_PAGE_TOKEN=

# The meeting bot (Recall.ai)
# Required: the public https address of this service, your tunnel's, e.g. https://assistant.example.com. The meeting
# bot loads its page from it, so a join is refused without it, and npm run check checks it.
PUBLIC_URL=
RECALL_API_KEY=
# Required, with no default: the region of your Recall account, since its API key works there only.
# us-east-1, us-west-2, eu-central-1 or ap-northeast-1. The service refuses to start without one.
RECALL_REGION=

# The bot page (the assistant's camera in the meeting): public/agent.html unless set. A page of your own must
# import startAgent from /agent.js and say "AI" where the meeting can see it, or the service refuses to start
# (see "The bot page" in docs/make-it-yours.md). {{name}}, {{owner}} and {{company}} in it are filled in. It is read once,
# when the service starts: restart the service after changing it.
# AGENT_PAGE_FILE=

# What scripts/install-service.sh names the installed service: the launchd label on macOS, the systemd user
# unit on Linux. Unload the old one first if you change it, or two services fight over the port.
# SERVICE_LABEL=local.agent-voice

# Optional overrides
# The model for spoken answers. Sonnet 5.5 by default; Opus 5.5 is as quick at low effort (it is given adaptive thinking).
# AGENT_MODEL=claude-sonnet-5-5
# The model that writes the minutes once a meeting is over (one call per meeting). Defaults to AGENT_MODEL.
# MINUTES_MODEL=claude-opus-5-5
# Days transcripts and minutes are kept.
# TRANSCRIPT_RETENTION_DAYS=30
# Extra words for Deepgram to listen out for, comma-separated (names, products, jargon). The assistant's
# name, OWNER_NAME and COMPANY_NAME are always included. Deepgram takes up to 100 terms and about 500 tokens in
# all; terms past that are left out, with a warning.
# DEEPGRAM_KEYTERMS=Recall.ai,Kubernetes
# true only if the ElevenLabs account has zero retention mode (enterprise accounts): the assistant's speech is
# then not kept in the ElevenLabs history. Without it ElevenLabs keeps every line the assistant says.
# ELEVENLABS_ZERO_RETENTION=true
# An optional extra: your own Telegram chats you may also send the assistant into a meeting from, comma-separated
# private chat IDs (the Claude Code Telegram plugin's chat_id). Unset: only a request typed in the Claude Code session.
# Read when the session starts its zoom-meeting server.
# ZOOM_JOIN_TELEGRAM_CHATS=123456789
