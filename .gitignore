node_modules/
# Your keys: .env and every other .env file, except the template.
.env
.env.*
!.env.example
# Keys and certificates, should one be made in this folder.
*.pem
*.key
*.p12
*.pfx
*.log
npm-debug.log*
.DS_Store
# Claude Code's own worktrees, if a session makes any here.
.claude/worktrees/
data/*
!data/.gitkeep
# Yours, never committed: the owner's profile (it may name private paths), your own Claude Code permissions, and the
# briefs you keep for single meetings (npm run join --brief), which hold your clients' facts.
profile.md
.claude/settings.local.json
/briefs/
# Your slide decks and their scripts (npm run slides), which hold your clients' slides and your own narration: keep
# them in decks/, or outside this folder. The root patterns catch a PDF prepared right here.
/decks/
/*.pdf
/*.script.md
# Your own list of private terms, which test/private-terms.test.ts checks the tree for (see test/private-terms.ts).
private-terms.txt
